{
  "manifest_version": 3,
  "name": "Upwork → ContactOut Email Harvester",
  "version": "0.3.0",
  "description": "Walks an Upwork talent search, matches each freelancer to a ContactOut profile by first name and education, and posts results to a Google Sheet sink.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://contactout.com/*",
    "https://*.contactout.com/*",
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upwork → ContactOut Harvester",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
